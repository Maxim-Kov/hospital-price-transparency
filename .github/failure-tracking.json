{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Configuration for the automated failure detection and remediation system",

  "config": {
    "rate_limits": {
      "max_issues_per_run": 10,
      "max_prs_per_day": 5,
      "min_confidence_for_autofix": 0.7,
      "cooldown_hours_after_failure": 24
    },
    "categories": {
      "url-update": {
        "auto_fixable": true,
        "priority": 1,
        "description": "URL changed, new URL available"
      },
      "registry-update": {
        "auto_fixable": true,
        "priority": 2,
        "description": "No scraper registered for URL pattern"
      },
      "encoding-fix": {
        "auto_fixable": true,
        "priority": 3,
        "description": "Character encoding issues"
      },
      "url-blocked": {
        "auto_fixable": false,
        "priority": 4,
        "description": "Access blocked (403)"
      },
      "needs-human": {
        "auto_fixable": false,
        "priority": 5,
        "description": "Complex issue requiring manual investigation"
      }
    },
    "labels": {
      "detection": ["scrape-failure", "ai-triage"],
      "analysis": ["url-update", "registry-update", "encoding-fix", "url-blocked", "needs-human"],
      "fix": ["auto-fix-ready", "auto-generated", "scrape-fix"]
    },
    "allowed_paths": [
      "dim/urls/*.json",
      "src/scrapers/registry.py"
    ]
  },

  "state": {
    "$comment": "This section is updated by CI workflows",
    "last_detection_run": null,
    "last_analysis_run": null,
    "fix_history": [],
    "known_issues": {}
  },

  "metrics": {
    "$comment": "Aggregated metrics for monitoring",
    "total_fixes_attempted": 0,
    "total_fixes_succeeded": 0,
    "total_fixes_failed": 0,
    "fixes_by_category": {
      "url-update": 0,
      "registry-update": 0,
      "encoding-fix": 0
    },
    "fixes_by_method": {
      "easy": 0,
      "hybrid": 0,
      "claude": 0
    }
  }
}
